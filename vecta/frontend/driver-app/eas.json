{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/api/v1",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:4000"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://vecta-elaf.onrender.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://vecta-elaf.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://vecta-elaf.onrender.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://vecta-elaf.onrender.com"
      }
    }
  }
}
